# Nebius Token Factory (required for hosted NVIDIA model inference)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional model tiering. The Personal AI track encourages reaching for a
# larger model only where the reasoning is hard: a parent agent plans, while
# three subagents make many cheap calls. Configure in .friday/config.toml:
#   [model]
#   reasoning_model = "nvidia/nemotron-3-ultra"          # generalist, planner, coder, verifier
#   fast_model      = "nvidia/nemotron-3-nano-omni"      # summarizer, researcher, memory, briefing, offline
# These two are only read by tests/nebius_live.rs.
NEBIUS_REASONING_MODEL=
NEBIUS_FAST_MODEL=

# Google OAuth client for read-only Gmail access (see docs/gmail.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: web search provider
TAVILY_API_KEY=

# Optional: local inference
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Server
FRIDAY_BIND=127.0.0.1:8787
FRIDAY_DB=sqlite://./data/friday.db?mode=rwc
RUST_LOG=friday=info
